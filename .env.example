# Copy this file to .env and adjust if the backend isn't running on
# localhost:8000 (e.g. the frontend is on a different device than the
# kiosk's Raspberry Pi running the FastAPI backend).
VITE_API_BASE_URL=http://localhost:8000

# Live ToF sensor feed (MQTT over WebSockets). Point this at the Pi running
# Mosquitto. Defaults to ws://<same host as the page>:9001 if not set.
VITE_MQTT_URL=ws://localhost:9001
VITE_TOF_TOPIC=medikiosk/sensors/tof
