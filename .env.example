# Copy this file to .env and adjust if the backend isn't running on
# localhost:8000 (e.g. the frontend is on a different device than the
# kiosk's Raspberry Pi running the FastAPI backend).
VITE_API_BASE_URL=http://localhost:8000

# The kiosk talks to its agent over MQTT (WebSockets). Point this at the
# machine running Mosquitto (the Pi, or your laptop while testing).
# Defaults to ws://<same host as the page>:9001 if not set.
VITE_MQTT_URL=ws://localhost:9001

# Which kiosk this tablet is (must match the agent's KIOSK_ID on the Pi).
VITE_KIOSK_ID=K-01

# DEV-ONLY: shows a "Skip login" button on the patient app, kiosk, and admin
# login screens while running `npm run dev` (never in production builds).
# Set to false to hide it.
VITE_DEV_AUTH_BYPASS=true
