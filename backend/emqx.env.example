# Backend -> EMQX Cloud settings (read by app/mqtt_bridge.py).
# Copy to a file OUTSIDE git on the server, e.g. /etc/medikiosk/backend.env,
# and load it with  EnvironmentFile=/etc/medikiosk/backend.env  in the systemd service.
# NEVER commit the filled-in file.
MQTT_HOST=xxxx.ala.ap-southeast-1.emqxsl.com
MQTT_PORT=8883
MQTT_TLS=1
MQTT_USER=backend
MQTT_PASSWORD=change-me
